<root main_tree_to_execute="RoutePoints">
  <BehaviorTree ID="RoutePoints">
    <RecoveryNode number_of_retries="3">
      <PipelineSequence>
        <RateController hz="1.0">
          <ReactiveSequence>
            <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.30"/>
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          </ReactiveSequence>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker" server_timeout="1000"/>
      </PipelineSequence>
      <Wait wait_duration="2" server_timeout="1000"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
